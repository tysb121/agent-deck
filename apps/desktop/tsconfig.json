{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": [
      "node",
      "vite/client"
    ],
    "noEmit": true,
    "jsx": "preserve"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/renderer/**/*",
    "electron.vite.config.ts",
    "src/renderer/**/*.vue",
    "src/renderer/env.d.ts"
  ]
}
